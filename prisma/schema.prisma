// =====================================================================
// ERD — Expense Management (multi-tenant, shared schema + RLS)
//
//   Organization 1─* User, Department, Project, Category, Expense,
//                    Receipt, ExpenseReport, Approval, Reimbursement,
//                    AuditLog          (every tenant table carries org_id)
//   SuperAdmin              platform-level, NO org_id, no org data access
//
//   User        *─1 Department (optional)
//   User        *─1 User (approver, self-relation, optional)
//   Expense     *─1 User (owner) · *─1 Category · *─1 Project (optional)
//   Expense     *─1 ExpenseReport (optional until added to a report)
//   Receipt     *─1 Expense
//   ExpenseReport *─1 User (owner)
//   Approval    *─1 ExpenseReport · *─1 User (approver)
//   Reimbursement 1─1 ExpenseReport · *─1 User (paid_by)
//   AuditLog    → (entity, entity_id) polymorphic; actor_id = User
//
// Conventions (CLAUDE.md):
//   - ids: UUIDv7 (client-generated via Prisma uuid(7))
//   - money: Int, minor units (cents/paise) — never floats
//   - org_id leads every composite index; no cross-org FKs
//   - report state machine: Draft → Submitted → Approved|Rejected|SentBack
//     → Reimbursed (transitions only via lib/domain/report-workflow.ts)
//   - AuditLog is append-only; nothing hard-deleted after Draft
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // app role (expense_app) — RLS enforced
  directUrl = env("DIRECT_DATABASE_URL") // owner role — migrations/seed only
}

enum Role {
  employee
  approver
  finance_admin
  org_admin

  @@map("role")
}

enum OrgStatus {
  active
  suspended

  @@map("org_status")
}

enum UserStatus {
  invited
  active
  deactivated

  @@map("user_status")
}

enum ExpenseType {
  regular
  mileage
  per_diem

  @@map("expense_type")
}

enum ExpenseStatus {
  draft
  submitted
  approved
  rejected
  reimbursed

  @@map("expense_status")
}

enum ReportStatus {
  draft
  submitted
  approved
  rejected
  sent_back
  partially_reimbursed
  reimbursed

  @@map("report_status")
}

enum PaymentMethod {
  bank_transfer
  upi
  cash
  payroll

  @@map("payment_method")
}

enum ApprovalAction {
  approved
  rejected
  sent_back

  @@map("approval_action")
}

model Organization {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String
  currency    String    @default("INR") @db.Char(3)
  mileageRate Int       @default(0) @map("mileage_rate") // minor units per km
  plan        String    @default("free")
  status      OrgStatus @default(active)
  settings    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users          User[]
  departments    Department[]
  projects       Project[]
  categories     Category[]
  perDiemRates   PerDiemRate[]
  accountingMappings AccountingMapping[]
  accountingExports  AccountingExport[]
  accountingExportReports AccountingExportReport[]
  expenses       Expense[]
  receipts       Receipt[]
  reports        ExpenseReport[]
  approvals      Approval[]
  reimbursements Reimbursement[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  budgets        Budget[]
  cardTransactions CardTransaction[]
  reportComments ReportComment[]
  approvalRules  ApprovalRule[]
  paymentBatches PaymentBatch[]
  advances       Advance[]
  clients        Client[]
  expenseSplits  ExpenseSplit[]
  recurringTemplates RecurringTemplate[]
  delegations    Delegation[]
  inboundEmailFailures InboundEmailFailure[]
  bankImports    BankStatementImport[]
  bankLines      BankStatementLine[]
  complaints     Complaint[]
  complaintMessages ComplaintMessage[]
  whatsappAccount   WhatsAppAccount?
  whatsappLinks     WhatsAppLink[]
  whatsappInbound   WhatsAppInbound[]
  whatsappOutbound  WhatsAppOutbound[]

  @@map("organizations")
}

// Platform operator — deliberately has NO org_id and no org data relations.
model SuperAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("super_admins")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  name         String
  email        String
  passwordHash String?    @map("password_hash") // null until invite accepted
  role         Role       @default(employee)
  departmentId String?    @map("department_id") @db.Uuid
  approverId   String?    @map("approver_id") @db.Uuid
  status       UserStatus @default(invited)
  // bank details for reimbursement (6.1) — account number is stored in full
  // but NEVER leaves the server unmasked (lib/domain/reimbursement.ts)
  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankIfsc          String? @map("bank_ifsc")
  upiId             String? @map("upi_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  approver     User?        @relation("UserApprover", fields: [approverId], references: [id])
  reportsTo    User[]       @relation("UserApprover")

  expenses       Expense[]
  reports        ExpenseReport[]
  approvals      Approval[]      @relation("ApprovalApprover")
  reimbursements Reimbursement[] @relation("ReimbursementPaidBy")
  paymentBatches PaymentBatch[]  @relation("PaymentBatchCreatedBy")
  advances       Advance[]       @relation("AdvanceOwner")
  advancesApproved Advance[]     @relation("AdvanceApprovedBy")
  recurringTemplates RecurringTemplate[]
  delegationsAsDelegate  Delegation[] @relation("DelegationDelegate")
  delegationsAsPrincipal Delegation[] @relation("DelegationPrincipal")
  bankImports    BankStatementImport[] @relation("BankImportImportedBy")
  notifications  Notification[]
  reportComments ReportComment[]
  complaintsRaised   Complaint[] @relation("ComplaintRaisedBy")
  complaintsAssigned Complaint[] @relation("ComplaintAssignedTo")
  complaintMessages  ComplaintMessage[] @relation("ComplaintMessageAuthor")
  whatsappLink       WhatsAppLink?
  whatsappInbound    WhatsAppInbound[]
  whatsappOutbound   WhatsAppOutbound[]
  accountingExports  AccountingExport[]

  @@unique([orgId, email])
  @@index([orgId, role])
  @@index([orgId, departmentId])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  users        User[]

  @@unique([orgId, name])
  @@map("departments")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  expenses     Expense[]
  splits       ExpenseSplit[]

  @@unique([orgId, code])
  @@index([orgId, name])
  @@map("projects")
}

/// Which accounting system an export targets.
///
/// `generic` is not a placeholder — it is the escape hatch for the long tail
/// (Zoho Books, Sage 50, a bookkeeper's spreadsheet) and emits a plain,
/// documented column set rather than a vendor dialect.
enum AccountingTarget {
  quickbooks
  xero
  netsuite
  tally
  generic

  @@map("accounting_target")
}

/// What kind of local record a mapping row points at.
///
/// Deliberately an enum rather than a table name: `user` maps to a VENDOR or
/// employee-payable account, `tax` to a tax code, and neither is a row in a
/// table called that. The enum names the CONCEPT being mapped.
enum AccountingEntityType {
  category
  department
  project
  user
  tax

  @@map("accounting_entity_type")
}

/// Local record → remote account code (P2 groundwork).
///
/// ── WHY `localId` HAS NO FOREIGN KEY ──────────────────────────────────────
/// It points at one of five different tables depending on `entityType`, and
/// Postgres has no polymorphic FK. The alternative — five nullable columns
/// with five FKs and a check constraint — buys referential integrity at the
/// cost of a schema that has to change every time a new entity type is
/// mappable. `tax` in particular is not a table at all today.
///
/// The trade is real and the mitigation is explicit: a mapping whose target
/// row has been deleted resolves to "unmapped" rather than to a stale code,
/// because resolution goes through the live entity list (see
/// lib/exports/accounting/mapping.ts), never through the mapping table alone.
model AccountingMapping {
  id         String               @id @default(uuid(7)) @db.Uuid
  orgId      String               @map("org_id") @db.Uuid
  target     AccountingTarget
  entityType AccountingEntityType @map("entity_type")
  /// The local record's UUID. See the note above on why this carries no FK.
  localId    String               @map("local_id") @db.Uuid
  /// The account code in the remote system — "6100", "Travel:Airfare".
  remoteCode String               @map("remote_code")
  /// Human label from the remote system, for the settings screen. Optional
  /// because a bookkeeper often knows only the code.
  remoteName String?              @map("remote_name")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  /// One mapping per local record PER TARGET: the same category maps to
  /// different codes in QuickBooks and in Tally, and both must coexist.
  @@unique([orgId, target, entityType, localId])
  @@index([orgId, target, entityType])
  @@map("accounting_mappings")
}

/// One export run.
///
/// ── SHAPED FOR A FUTURE API ADAPTER, NOT JUST A FILE ──────────────────────
/// `fileKey` is NULLABLE and `remoteRef` exists although nothing writes it
/// yet. A two-way adapter posting journal entries to the QuickBooks API
/// produces no file and returns a remote id; recording that is the difference
/// between "this run happened" and "this run happened and here is what the
/// other system called it". Adding those columns later would mean migrating a
/// table that already holds the audit trail of every export finance has run.
model AccountingExport {
  id           String           @id @default(uuid(7)) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  target       AccountingTarget
  periodStart  DateTime         @map("period_start") @db.Date
  periodEnd    DateTime         @map("period_end") @db.Date
  exportedAt   DateTime         @default(now()) @map("exported_at")
  exportedById String           @map("exported_by_id") @db.Uuid
  /// Object-store key. Null for a delivery that produced no file.
  fileKey      String?          @map("file_key")
  /// What the remote system called this batch. Null until an API adapter exists.
  remoteRef    String?          @map("remote_ref")
  /// Denormalised from the artifact so the history list needs no re-derivation.
  lineCount    Int              @map("line_count")
  totalMinor   Int              @map("total_minor")

  organization Organization             @relation(fields: [orgId], references: [id])
  exportedBy   User                     @relation(fields: [exportedById], references: [id])
  reports      AccountingExportReport[]

  @@index([orgId, target, exportedAt])
  @@map("accounting_exports")
}

/// Which reports went into which export run.
///
/// ── A JOIN TABLE, NOT A `report_ids` ARRAY ────────────────────────────────
/// The double-export guard asks "has THIS report been exported to THIS
/// target?" on every export and on every report detail page. Against a JSON
/// array that is a sequential scan of every export row the org has ever made;
/// against this table it is an index hit on (org_id, report_id). The guard is
/// the feature — modelling it as something that gets slower the longer
/// finance uses the product would undermine it.
model AccountingExportReport {
  id       String @id @default(uuid(7)) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  exportId String @map("export_id") @db.Uuid
  reportId String @map("report_id") @db.Uuid

  organization Organization     @relation(fields: [orgId], references: [id])
  export       AccountingExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  report       ExpenseReport    @relation(fields: [reportId], references: [id])

  @@unique([orgId, exportId, reportId])
  /// THE double-export guard's lookup.
  @@index([orgId, reportId])
  @@map("accounting_export_reports")
}

/// Per-diem daily allowance rates (PRD P1). Finance-configurable, org-scoped.
///
/// VERSIONED BY DATE, NOT EDITED IN PLACE. Rates change — a city moves tier,
/// a new financial year lifts the allowance — and an expense filed last March
/// must keep last March's rate. So a "rate" is really a NAME with a history:
/// rows sharing (orgId, name) are versions of one allowance, and the one that
/// applies to a trip is the newest active row whose effectiveFrom is on or
/// before the trip's start date. `lib/domain/per-diem.ts` owns that selection;
/// `Expense.perDiemRateId` pins the row that was actually used.
///
/// Hence no unique constraint on (orgId, name): several versions of the same
/// name is the point. (orgId, name, effectiveFrom) IS unique — two rates for
/// one name starting the same day is ambiguous, not a history.
model PerDiemRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  /// Free text — "Mumbai", "Tier 1 metro", "International — APAC". Optional
  /// because a flat org-wide allowance needs no location at all.
  location      String?
  /// Minor units, ORG BASE currency. Per-diem is an internal allowance, so it
  /// is never foreign-currency: there is nothing to convert from.
  dailyAmount   Int      @map("daily_amount")
  effectiveFrom DateTime @map("effective_from") @db.Date
  /// Retire a rate without deleting it — expenses still point at it.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  expenses     Expense[]

  @@unique([orgId, name, effectiveFrom])
  // org_id leads every index (CLAUDE.md). This one also serves the effective-
  // rate lookup, which filters by name and orders by effectiveFrom desc.
  @@index([orgId, name, effectiveFrom])
  @@index([orgId, active])
  @@map("per_diem_rates")
}

model Category {
  id                   String   @id @default(uuid(7)) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  name                 String
  perExpenseLimit      Int?     @map("per_expense_limit") // minor units
  monthlyLimit         Int?     @map("monthly_limit") // minor units
  receiptRequiredAbove Int?     @map("receipt_required_above") // minor units
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  expenses     Expense[]
  splits       ExpenseSplit[]
  recurringTemplates RecurringTemplate[]

  @@unique([orgId, name])
  @@map("categories")
}

model Expense {
  id         String        @id @default(uuid(7)) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  reportId   String?       @map("report_id") @db.Uuid
  type       ExpenseType   @default(regular)
  amount     Int // minor units, ORIGINAL currency
  currency   String        @db.Char(3)
  fxRate     String        @default("1") @map("fx_rate") // decimal string, original → base
  baseAmount Int           @map("base_amount") // minor units, ORG BASE currency
  date       DateTime      @db.Date
  merchant   String
  categoryId String        @map("category_id") @db.Uuid
  projectId  String?       @map("project_id") @db.Uuid
  purpose    String        @default("")
  distanceKm Int?          @map("distance_km") // mileage type only
  // ---- per_diem type only ----
  // The rate row actually used, PINNED at save time. Rates are versioned by
  // effectiveFrom, so pointing at the row (not the name) is what stops a
  // later rate change silently re-pricing an expense somebody already
  // approved. Restrict on delete for the same reason.
  perDiemRateId   String?   @map("per_diem_rate_id") @db.Uuid
  perDiemStart    DateTime? @map("per_diem_start") @db.Date
  perDiemEnd      DateTime? @map("per_diem_end") @db.Date
  // Whole COUNT OF HALF-DAYS, not days: the unit is halved so the column
  // stays an integer. 3 full days = 6; 2 days with a half travel day at each
  // end = 6 - 1 - 1 = 4. See lib/domain/per-diem.ts for the rule.
  perDiemHalfDays Int?      @map("per_diem_half_days")
  status     ExpenseStatus @default(draft)
  flags      Json          @default("[]") // policy violation flags, never block
  billable   Boolean       @default(false)
  clientId   String?       @map("client_id") @db.Uuid
  taxAmount  Int?          @map("tax_amount") // minor units (GST/VAT portion)
  taxNumber  String?       @map("tax_number") // GST/VAT registration on the bill
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [orgId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  report       ExpenseReport? @relation(fields: [reportId], references: [id])
  category     Category       @relation(fields: [categoryId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  perDiemRate  PerDiemRate?   @relation(fields: [perDiemRateId], references: [id])
  receipts     Receipt[]
  cardTransaction CardTransaction?
  client       Client?        @relation(fields: [clientId], references: [id])
  splits       ExpenseSplit[]
  whatsappInbound WhatsAppInbound[]

  // duplicate detection probe: org + user + amount + date (+ merchant, compared case-insensitively in app)
  @@index([orgId, userId, amount, date])
  @@index([orgId, reportId])
  @@index([orgId, categoryId, date])
  @@index([orgId, status])
  @@map("expenses")
}

model Receipt {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  expenseId  String   @map("expense_id") @db.Uuid
  storageKey String   @map("storage_key") // /{org_id}/receipts/{expense_id}/...
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  ocrData    Json?    @map("ocr_data") // {merchant?, date?, amount?}
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  expense      Expense      @relation(fields: [expenseId], references: [id])

  @@index([orgId, expenseId])
  @@map("receipts")
}

model ExpenseReport {
  id          String       @id @default(uuid(7)) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  title       String
  status      ReportStatus @default(draft)
  submittedAt DateTime?    @map("submitted_at")
  total       Int          @default(0) // minor units, derived from expenses
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [orgId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  expenses       Expense[]
  approvals      Approval[]
  reimbursements Reimbursement[]
  comments       ReportComment[]
  complaints     Complaint[]
  accountingExportReports AccountingExportReport[]

  @@index([orgId, userId, status])
  @@index([orgId, status, submittedAt])
  @@map("expense_reports")
}

model Approval {
  id         String         @id @default(uuid(7)) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  reportId   String         @map("report_id") @db.Uuid
  approverId String         @map("approver_id") @db.Uuid
  level      Int            @default(1)
  action     ApprovalAction
  reason     String? // required for reject/send_back (enforced in domain layer)
  actedAt    DateTime       @default(now()) @map("acted_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  report       ExpenseReport @relation(fields: [reportId], references: [id])
  approver     User          @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([orgId, reportId])
  @@index([orgId, approverId, actedAt])
  @@map("approvals")
}

// Payment record (6.1): a report may have MANY (partial payments).
// amount = report total at payment time; amountPaid = money moved.
model Reimbursement {
  id         String        @id @default(uuid(7)) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  reportId   String        @map("report_id") @db.Uuid
  amount     Int // minor units — report total at payment time
  amountPaid Int           @map("amount_paid") // minor units — this payment
  method     PaymentMethod @default(bank_transfer)
  paidAt     DateTime      @map("paid_at")
  reference  String // UTR / cheque / payroll run id
  batchId    String?       @map("batch_id") @db.Uuid
  proofKey   String?       @map("proof_key") // /{orgId}/payment-proofs/...
  paidById   String        @map("paid_by_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  report       ExpenseReport @relation(fields: [reportId], references: [id])
  batch        PaymentBatch? @relation(fields: [batchId], references: [id])
  paidBy       User          @relation("ReimbursementPaidBy", fields: [paidById], references: [id])
  bankLine     BankStatementLine?
  complaints   Complaint[]

  @@index([orgId, reportId])
  @@index([orgId, paidAt])
  @@index([orgId, batchId])
  @@map("reimbursements")
}

// One finance payment run (6.1) grouping many report payments.
model PaymentBatch {
  id          String        @id @default(uuid(7)) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  createdById String        @map("created_by_id") @db.Uuid
  method      PaymentMethod @default(bank_transfer)
  paidAt      DateTime      @map("paid_at")
  notes       String        @default("")
  createdAt   DateTime      @default(now()) @map("created_at")

  organization Organization    @relation(fields: [orgId], references: [id])
  createdBy    User            @relation("PaymentBatchCreatedBy", fields: [createdById], references: [id])
  payments     Reimbursement[]

  @@index([orgId, paidAt])
  @@map("payment_batches")
}

// Append-only. No updatedAt by design; rows are never modified or deleted.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  entity    String // e.g. "ExpenseReport"
  entityId  String   @map("entity_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid // null for system actions
  action    String // e.g. "report.submitted"
  meta      Json     @default("{}")
  timestamp DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, entity, entityId])
  @@index([orgId, timestamp])
  @@map("audit_logs")
}

// In-app notification (2.3). Recipient-targeted; reads are pinned to the
// session user on top of org scoping.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String // e.g. "report.submitted"
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, readAt])
  @@index([orgId, userId, createdAt])
  @@map("notifications")
}

enum BudgetScope {
  department
  project
  category

  @@map("budget_scope")
}

enum BudgetPeriod {
  monthly
  quarterly
  yearly

  @@map("budget_period")
}

// Budget (P1, PLAN 5.1): amount per scope per recurring period. scope_id is
// polymorphic (department/project/category id) — validated at the action
// layer inside the same org scope; no cross-org FK is possible because
// every lookup goes through scopedDb.
model Budget {
  id        String       @id @default(uuid(7)) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  scopeType BudgetScope  @map("scope_type")
  scopeId   String       @map("scope_id") @db.Uuid
  period    BudgetPeriod @default(monthly)
  amount    Int // minor units per period
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, scopeType, scopeId, period])
  @@index([orgId, scopeType])
  @@map("budgets")
}

// Card statement line (P1, PLAN 5.2). Org-level (company card); imported in
// batches by finance. matched_expense_id is 1:1 — an expense reconciles
// with at most one statement line.
model CardTransaction {
  id               String   @id @default(uuid(7)) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  importedBatch    String   @map("imported_batch") @db.Uuid
  date             DateTime @db.Date
  amount           Int // minor units
  merchant         String
  matchedExpenseId String?  @unique @map("matched_expense_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [orgId], references: [id])
  matchedExpense Expense?     @relation(fields: [matchedExpenseId], references: [id])

  @@index([orgId, matchedExpenseId])
  @@index([orgId, importedBatch])
  @@index([orgId, date])
  @@map("card_transactions")
}

// Report discussion thread (P1, PLAN 5.3). Append-only — comments are part
// of the audit story and are never edited or deleted.
model ReportComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  report       ExpenseReport @relation(fields: [reportId], references: [id])
  author       User          @relation(fields: [authorId], references: [id])

  @@index([orgId, reportId, createdAt])
  @@map("report_comments")
}

// Custom approval chain rule (P1, PLAN 5.4). The most specific matching
// rule (department+amount > department > amount) overrides level-1 routing
// and may pin a specific second approver; otherwise the assigned-approver +
// org-threshold defaults apply.
model ApprovalRule {
  id               String   @id @default(uuid(7)) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  name             String
  departmentId     String?  @map("department_id") @db.Uuid // null = all departments
  aboveAmount      Int?     @map("above_amount") // minor units; null = any amount
  approverId       String   @map("approver_id") @db.Uuid
  secondApproverId String?  @map("second_approver_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, departmentId])
  @@map("approval_rules")
}

enum AdvanceStatus {
  draft
  submitted
  approved
  rejected
  disbursed
  partially_settled
  settled

  @@map("advance_status")
}

// Cash advance / trip pre-approval (PLAN 6.2). Transitions only through
// lib/domain/advance.ts; settlement offsets reimbursed reports against the
// oldest open advances.
model Advance {
  id                   String        @id @default(uuid(7)) @db.Uuid
  orgId                String        @map("org_id") @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  amount               Int // minor units
  purpose              String
  tripStart            DateTime?     @map("trip_start") @db.Date
  tripEnd              DateTime?     @map("trip_end") @db.Date
  status               AdvanceStatus @default(draft)
  approvedById         String?       @map("approved_by_id") @db.Uuid
  disbursedAt          DateTime?     @map("disbursed_at")
  disbursementRef      String?       @map("disbursement_ref")
  disbursementProofKey String?       @map("disbursement_proof_key")
  settledAmount        Int           @default(0) @map("settled_amount")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation("AdvanceOwner", fields: [userId], references: [id])
  approvedBy   User?        @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])

  @@index([orgId, userId, status])
  @@index([orgId, status])
  @@map("advances")
}

// Billing client (PLAN 6.3) — who an expense can be billed to.
model Client {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  expenses     Expense[]

  @@unique([orgId, code])
  @@unique([orgId, name])
  @@map("clients")
}

// Expense split (PLAN 6.3): one expense allocated across categories /
// projects. INVARIANT: a expense's splits sum EXACTLY to its amount
// (integer minor units — enforced in lib/domain/expense-split.ts and the
// actions; last split absorbs any percent-rounding remainder).
model ExpenseSplit {
  id         String  @id @default(uuid(7)) @db.Uuid
  orgId      String  @map("org_id") @db.Uuid
  expenseId  String  @map("expense_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  amount     Int // minor units

  organization Organization @relation(fields: [orgId], references: [id])
  expense      Expense      @relation(fields: [expenseId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([orgId, expenseId])
  @@index([orgId, categoryId])
  @@map("expense_splits")
}

enum RecurringCadence {
  monthly
  weekly

  @@map("recurring_cadence")
}

// Recurring expense template (PLAN 6.5). The cron job drafts an expense on
// schedule; last_run_at makes drafting duplicate-safe.
model RecurringTemplate {
  id         String           @id @default(uuid(7)) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  cadence    RecurringCadence
  // monthly: day of month 1–28; weekly: ISO weekday 1 (Mon) – 7 (Sun)
  day        Int
  amount     Int // minor units, org base currency
  categoryId String           @map("category_id") @db.Uuid
  merchant   String
  purpose    String           @default("")
  active     Boolean          @default(true)
  lastRunAt  DateTime?        @map("last_run_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])

  @@index([orgId, userId])
  @@index([orgId, active])
  @@map("recurring_templates")
}

// Delegate access (PLAN 6.5): delegate may act ON BEHALF OF principal for
// expenses/reports — never for approvals. No self-delegation (action guard).
model Delegation {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  delegateId  String   @map("delegate_id") @db.Uuid
  principalId String   @map("principal_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  delegate     User         @relation("DelegationDelegate", fields: [delegateId], references: [id])
  principal    User         @relation("DelegationPrincipal", fields: [principalId], references: [id])

  @@unique([orgId, delegateId, principalId])
  @@index([orgId, delegateId, active])
  @@map("delegations")
}

// Dead-letter list for email receipt ingestion (PLAN 6.6) — org_admin
// reviews why an inbound email produced nothing.
model InboundEmailFailure {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  fromEmail String   @map("from_email")
  subject   String   @default("")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("inbound_email_failures")
}

enum BankMatchType {
  auto
  manual

  @@map("bank_match_type")
}

// Bank statement import batch (PLAN 7.2). column_mapping records which
// statement columns were used; locked_at freezes the reconciled period.
model BankStatementImport {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  filename     String
  columnMapping Json     @map("column_mapping")
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  lockedAt     DateTime? @map("locked_at")
  importedById String    @map("imported_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [orgId], references: [id])
  importedBy   User                @relation("BankImportImportedBy", fields: [importedById], references: [id])
  lines        BankStatementLine[]

  @@index([orgId, createdAt])
  @@map("bank_statement_imports")
}

// One statement debit line. A reimbursement reconciles with at most ONE
// line (unique) and vice versa.
model BankStatementLine {
  id                     String         @id @default(uuid(7)) @db.Uuid
  orgId                  String         @map("org_id") @db.Uuid
  importId               String         @map("import_id") @db.Uuid
  date                   DateTime       @db.Date
  amount                 Int // minor units, org base currency
  reference              String
  matchedReimbursementId String?        @unique @map("matched_reimbursement_id") @db.Uuid
  matchType              BankMatchType? @map("match_type")

  organization Organization        @relation(fields: [orgId], references: [id])
  import       BankStatementImport @relation(fields: [importId], references: [id])
  matchedReimbursement Reimbursement? @relation(fields: [matchedReimbursementId], references: [id])

  @@index([orgId, importId])
  @@index([orgId, date])
  @@map("bank_statement_lines")
}

enum ComplaintType {
  wrong_amount
  unfair_rejection
  payment_not_received
  other

  @@map("complaint_type")
}

enum ComplaintStatus {
  open
  in_review
  resolved
  wont_fix

  @@map("complaint_status")
}

// Expense-linked dispute (PLAN 7.3). Exactly one of reportId / reimbursementId
// is set — enforced by a DB CHECK constraint (see migration) and by
// lib/domain/complaint.ts. Routing never assigns the complaint to the approver
// whose decision is being disputed (canAssignComplaint). Once resolved the
// record is immutable except for the message thread.
model Complaint {
  id              String          @id @default(uuid(7)) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  raisedById      String          @map("raised_by_id") @db.Uuid
  reportId        String?         @map("report_id") @db.Uuid
  reimbursementId String?         @map("reimbursement_id") @db.Uuid
  type            ComplaintType
  description     String
  attachmentKey   String?         @map("attachment_key") // /{orgId}/complaints/...
  status          ComplaintStatus @default(open)
  assignedToId    String?         @map("assigned_to_id") @db.Uuid
  resolutionNote  String?         @map("resolution_note")
  resolvedAt      DateTime?       @map("resolved_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [orgId], references: [id])
  raisedBy      User               @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  assignedTo    User?              @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  report        ExpenseReport?     @relation(fields: [reportId], references: [id])
  reimbursement Reimbursement?     @relation(fields: [reimbursementId], references: [id])
  messages      ComplaintMessage[]

  @@index([orgId, status, createdAt])
  @@index([orgId, raisedById, createdAt])
  @@index([orgId, assignedToId, status])
  @@map("complaints")
}

// Complaint thread message. Appendable even after the complaint is resolved.
model ComplaintMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id])
  author       User         @relation("ComplaintMessageAuthor", fields: [authorId], references: [id])

  @@index([orgId, complaintId, createdAt])
  @@map("complaint_messages")
}

// WhatsApp Business account for an org (PLAN 8.1). Credentials are stored
// encrypted (AES-256-GCM, lib/crypto/secret-box.ts) and never leave the
// server. phoneNumberId is globally unique because it is how an inbound
// webhook is routed to an org BEFORE any session exists — the one lookup in
// this feature that legitimately precedes a tenant scope.
model WhatsAppAccount {
  id               String    @id @default(uuid(7)) @db.Uuid
  orgId            String    @unique @map("org_id") @db.Uuid
  enabled          Boolean   @default(false)
  phoneNumberId    String    @unique @map("phone_number_id")
  businessPhone    String    @map("business_phone") // display only, E.164
  tokenCipher      String?   @map("token_cipher")
  appSecretCipher  String?   @map("app_secret_cipher")
  verifyTokenCipher String?  @map("verify_token_cipher")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("whatsapp_accounts")
}

// A user's linked WhatsApp number. One number per user, and a number can only
// be claimed once inside an org — the SAME number may be linked in another
// org, so inbound routing is always (business number -> org) first, then
// (from number -> user WITHIN that org).
model WhatsAppLink {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  phoneE164    String    @map("phone_e164")
  verifiedAt   DateTime? @map("verified_at")
  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpAttempts  Int       @default(0) @map("otp_attempts")
  optedOut     Boolean   @default(false) @map("opted_out")
  /** Last message FROM this person — opens Meta's 24-hour session window (8.3). */
  lastInboundAt DateTime? @map("last_inbound_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, phoneE164])
  @@index([orgId, verifiedAt])
  @@map("whatsapp_links")
}

enum WhatsAppInboundStatus {
  pending
  processed
  ignored
  failed

  @@map("whatsapp_inbound_status")
}

// Raw inbound message, persisted for 8.2 to consume. waMessageId is unique so
// Meta's at-least-once delivery cannot create duplicate expenses.
model WhatsAppInbound {
  id            String                @id @default(uuid(7)) @db.Uuid
  orgId         String                @map("org_id") @db.Uuid
  waMessageId   String                @unique @map("wa_message_id")
  fromPhone     String                @map("from_phone")
  phoneNumberId String                @map("phone_number_id")
  userId        String?               @map("user_id") @db.Uuid
  messageType   String                @map("message_type") // text | image | document | ...
  text          String?
  mediaId       String?               @map("media_id")
  /** Draft created from this message (8.2) — the button callbacks act on it. */
  expenseId     String?               @map("expense_id") @db.Uuid
  payload       Json                  @default("{}")
  status        WhatsAppInboundStatus @default(pending)
  error         String?
  receivedAt    DateTime              @map("received_at")
  processedAt   DateTime?             @map("processed_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  expense      Expense?     @relation(fields: [expenseId], references: [id])

  @@index([orgId, status, receivedAt])
  @@index([orgId, fromPhone, receivedAt])
  @@map("whatsapp_inbound")
}


enum WhatsAppOutboundStatus {
  queued
  sent
  delivered
  read
  failed

  @@map("whatsapp_outbound_status")
}

// Outbound send log (8.3): retries with backoff, plus delivery receipts from
// Meta's status webhook. Notifications must never fail a workflow, so this is
// where failures land instead of being thrown.
model WhatsAppOutbound {
  id           String                 @id @default(uuid(7)) @db.Uuid
  orgId        String                 @map("org_id") @db.Uuid
  userId       String?                @map("user_id") @db.Uuid
  toPhone      String                 @map("to_phone")
  event        String
  /** template name, or null for a free-form (in-session) message */
  templateName String?                @map("template_name")
  waMessageId  String?                @unique @map("wa_message_id")
  status       WhatsAppOutboundStatus @default(queued)
  attempts     Int                    @default(0)
  error        String?
  entityType   String?                @map("entity_type")
  entityId     String?                @map("entity_id")
  sentAt       DateTime?              @map("sent_at")
  deliveredAt  DateTime?              @map("delivered_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([orgId, status, createdAt])
  @@index([orgId, userId, createdAt])
  @@map("whatsapp_outbound")
}
