# App connection — non-superuser role, RLS ENFORCED (docker compose defaults)
DATABASE_URL="postgresql://expense_app:expense_app@localhost:5432/expense_dev?schema=public"
# Owner connection — migrations + seed only (superuser, bypasses RLS)
DIRECT_DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_dev?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# S3-compatible storage. One set of variables drives every environment;
# lib/storage/s3.ts holds no provider-specific code.
#
# LOCAL / CI — MinIO from docker-compose.yml. Keep these as-is: the e2e and
# isolation suites bring MinIO up themselves and expect this bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="receipts"
S3_FORCE_PATH_STYLE="true"
#
# PRODUCTION — Cloudflare R2. Set these in the deploy environment, NOT here:
# the keys grant read/write to every tenant's receipts, so they belong in
# a secret store, not a file in the repo.
#
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"                 # literal "auto" — R2 rejects real region names
#   S3_ACCESS_KEY_ID="<r2 access key id>"
#   S3_SECRET_ACCESS_KEY="<r2 secret access key>"
#   S3_BUCKET="<r2 bucket name>"
#   S3_FORCE_PATH_STYLE="false"      # R2 uses virtual-hosted style
#
# Create the token under R2 > Manage API Tokens with "Object Read & Write",
# scoped to that one bucket, and leave the bucket PRIVATE — every read goes
# through a presigned URL so the org check in lib/storage/*.ts stays the only
# way in. Uploads are server-side and reads render via <img>/<iframe>, so no
# CORS rules are needed on the bucket.

# Rate limiting behind a proxy. X-Forwarded-For is APPENDED to by each hop,
# so its leftmost entry is whatever the client sent and must never be
# trusted. Set this to the number of proxies YOU run in front of the app
# (Vercel/Cloudflare in front of nothing else = 1); the limiter then counts
# that many entries in from the right. 0 (the default) ignores the header.
TRUSTED_PROXY_HOPS="0"

# Secret for scheduled jobs (approval digest): openssl rand -hex 32
CRON_SECRET="replace-me"

# Inbound email receipts (6.6) — Mailgun forward route
# Route: match_recipient("receipts+.*@<APP_MAIL_DOMAIN>") -> forward(https://<host>/api/webhooks/inbound-email)
MAILGUN_WEBHOOK_SIGNING_KEY="replace-with-mailgun-http-webhook-signing-key"
APP_MAIL_DOMAIN="mail.example.com"

# Credential encryption at rest (8.1) — 32 bytes: openssl rand -base64 32
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# WhatsApp Business Cloud API (8.1) — OPTIONAL.
# Leave unset and the WhatsApp feature is hidden everywhere; the app is
# fully functional without it. Per-org credentials entered in
# Settings > WhatsApp override these (stored encrypted).
# Webhook URL to register with Meta: https://<host>/api/webhooks/whatsapp
WA_PHONE_NUMBER_ID=""      # Meta > WhatsApp > API setup > Phone number ID
WA_TOKEN=""                # permanent system-user access token
WA_VERIFY_TOKEN=""         # any random string; echoed in the GET handshake
WA_APP_SECRET=""           # Meta app secret — verifies X-Hub-Signature-256
WA_BUSINESS_PHONE=""       # display only, E.164
WA_GRAPH_VERSION="v21.0"
